{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nix binary installer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "system",
    "sha256"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "$schema."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "version."
    },
    "system": {
      "const": "x86_64-linux",
      "description": "system."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "sha256."
    }
  }
}
